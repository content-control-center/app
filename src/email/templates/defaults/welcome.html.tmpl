<!doctype html>
<html>
  <body style="margin:0;padding:24px;background:#f6f7f9;font-family:Arial,Helvetica,sans-serif;color:#1a1a1a;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
      <tr>
        <td align="center">
          <table role="presentation" width="560" cellpadding="0" cellspacing="0" style="background:#ffffff;border-radius:12px;padding:32px;">
            <tr><td>
              <h1 style="margin:0 0 16px;font-size:22px;">Welcome to Ogen, [[ .Name ]] 👋</h1>
              <p style="margin:0 0 16px;line-height:1.5;">Your workspace <strong>[[ .WorkspaceName ]]</strong> is ready to go.</p>
              <p style="margin:0 0 24px;line-height:1.5;">Ogen helps you plan, generate, and publish social content from one place. Connect an account and schedule your first post whenever you're ready.</p>
              <p style="margin:0 0 24px;">
                <a href="[[ .AppURL ]]" style="display:inline-block;background:#5e6ad2;color:#ffffff;text-decoration:none;padding:12px 20px;border-radius:8px;">Open your workspace</a>
              </p>
              <p style="margin:0;color:#555;line-height:1.5;">— The Ogen team</p>
            </td></tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
