<!doctype html>
<html>
  <body style="margin:0;padding:24px;background:#f6f7f9;font-family:Arial,Helvetica,sans-serif;color:#1a1a1a;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
      <tr>
        <td align="center">
          <table role="presentation" width="560" cellpadding="0" cellspacing="0" style="background:#ffffff;border-radius:12px;padding:32px;">
            <tr><td>
              <h1 style="margin:0 0 16px;font-size:20px;">How's it going, [[ .Name ]]?</h1>
              <p style="margin:0 0 16px;line-height:1.5;">You've had Ogen for a week. If anything's in your way, just reply to this email — a real person reads it. Otherwise, here's your workspace.</p>
              <p style="margin:0 0 24px;">
                <a href="[[ .AppURL ]]" style="display:inline-block;background:#5e6ad2;color:#ffffff;text-decoration:none;padding:12px 20px;border-radius:8px;">Open [[ .WorkspaceName ]]</a>
              </p>
              <hr style="border:none;border-top:1px solid #eee;margin:24px 0;">
              <p style="margin:0;font-size:12px;color:#888;line-height:1.5;">You're getting onboarding tips for [[ .WorkspaceName ]]. <a href="[[ .UnsubscribeURL ]]" style="color:#888;">Unsubscribe</a>.</p>
            </td></tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
