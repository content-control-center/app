# Ogen local stack configuration — consumed by docker-compose.yml.
# Created from the template:  cp .env.example .env
# This file is gitignored. Never commit it (it holds real secrets).

# --- API service ---
ADDR=:9001
DATABASE_DSN=postgres://ogen:ogen@postgres:5432/ogen?sslmode=disable
EMBED_SERVER_URL=http://llama-embedserver:8080

# Envelope-encryption KEK directory (mounted from the ogen-keys volume).
OGEN_KEK_PATH=/var/lib/ogen/keys

# Object storage (Cloudflare R2 / S3-compatible).
# Leave STORAGE_ENDPOINT empty to disable image/PDF uploads.
STORAGE_ENDPOINT=https://17efea3963b045025b9ecbdcad609273.r2.cloudflarestorage.com
STORAGE_REGION=auto
STORAGE_ACCESS_KEY=8e38dd1e0588e37b3e1505774734c39a
STORAGE_SECRET_KEY=22f9c64dc22a5d9435e26fd3c23bbf927d17724690656bd11c6f3237a594d35f
STORAGE_BUCKET=c3-test
STORAGE_PUBLIC_URL=https://pub-da48e7d6eb8d467cb834c4c5dfd27fc6.r2.dev

# Zernio post-OAuth redirect target.
ZERNIO_REDIRECT_URL=http://localhost:9001

# --- Postgres service ---
POSTGRES_USER=ogen
POSTGRES_PASSWORD=ogen
POSTGRES_DB=ogen
