@baseUrl = http://localhost:9001

# All campaign endpoints require authentication.
# Run "Login" from sessions/sessions.http first — the HTTP client stores and
# sends the cookie automatically on subsequent requests to the same host.

### List all campaigns  [protected]
GET {{baseUrl}}/api/campaigns
Accept: application/json

### Create campaign — minimal  [protected]
# @name createCampaign
POST {{baseUrl}}/api/campaigns
Content-Type: application/json

{
  "name": "Summer Awareness Push",
  "objective": "awareness"
}

> {% client.global.set("campaignId", response.body.id) %}

### Create campaign — all fields  [protected]
POST {{baseUrl}}/api/campaigns
Content-Type: application/json

{
    "name": "Rust programming language in modern financial applications",
    "description": "Educate financial technology professionals and engineering leaders on the advantages of Rust for building high-performance, memory-safe financial systems — from trading engines to risk modeling pipelines.",
    "target_persona": "Senior software engineers, tech leads, and CTOs at fintech companies and financial institutions, aged 28–45, evaluating systems-level languages for latency-sensitive and safety-critical workloads.",
    "key_messages": "Rust delivers C++-level performance with compile-time memory safety — no garbage collector pauses, no data races, no 3 AM crashes in production. The language the finance industry didn't know it was waiting for.",
    "tone_guidelines": "Technically credible yet accessible. Confident without being preachy. Speak peer-to-peer with engineers — show, don't sell. Use concrete benchmarks and real-world case studies over abstract claims.",
    "objective": "awareness",
    "status": "scheduled",
    "use_pieces": true,
    "pieces_ids": [],
    "target_platforms": [
        {"id": "AXqWG7U2qnpt", "post_types": ["text-post", "article", "carousel"]},
        {"id": "zBU1zqVICGfk", "post_types": ["text-post", "image-post", "video"]},
        {"id": "pQ4yxT3SuE57", "post_types": ["text-post"]}
    ],
    "start_date": "2026-10-01T00:00:00Z",
    "end_date": "2026-12-31T23:59:59Z",
    "estimated_post_count": 30,
    "budget": 5000.00,
    "currency": "USD",
    "language": "en",
    "tag_ids": []
}

> {% client.global.set("campaignId", response.body.id) %}

### Create campaign — missing name (expects 400)  [protected]
POST {{baseUrl}}/api/campaigns
Content-Type: application/json

{
  "objective": "awareness"
}

### Create campaign — missing objective (expects 400)  [protected]
POST {{baseUrl}}/api/campaigns
Content-Type: application/json

{
  "name": "No Objective Campaign"
}

### Create campaign — invalid objective (expects 400)  [protected]
POST {{baseUrl}}/api/campaigns
Content-Type: application/json

{
  "name": "Bad Objective",
  "objective": "domination"
}

### Create campaign — invalid status (expects 400)  [protected]
POST {{baseUrl}}/api/campaigns
Content-Type: application/json

{
  "name": "Bad Status",
  "objective": "awareness",
  "status": "unknown"
}

### Get campaign by ID  [protected]
GET {{baseUrl}}/api/campaigns/{{campaignId}}
Accept: application/json

### Get campaign — non-existent ID (expects 404)  [protected]
GET {{baseUrl}}/api/campaigns/nonexistent
Accept: application/json

### Update campaign  [protected]
PUT {{baseUrl}}/api/campaigns/{{campaignId}}
Content-Type: application/json

{
  "name": "Q4 Conversion Drive — Revised",
  "description": "Updated copy after stakeholder review.",
  "target_persona": "Tech-savvy millennials aged 25–35",
  "key_messages": "Fast, reliable, affordable — now with team plans.",
  "tone_guidelines": "Friendly, confident, and jargon-free.",
  "objective": "conversion",
  "status": "active",
  "use_pieces": true,
  "pieces_ids": [],
  "target_platform_ids": ["rzgpTkARLH0L", "AXqWG7U2qnpt"],
  "estimated_post_count": 25,
  "budget": 6000.00,
  "currency": "USD",
  "language": "en",
  "tag_ids": []
}

### Update campaign — invalid objective (expects 400)  [protected]
PUT {{baseUrl}}/api/campaigns/{{campaignId}}
Content-Type: application/json

{
  "name": "Bad Update",
  "objective": "domination"
}

### Update campaign — non-existent ID (expects 404)  [protected]
PUT {{baseUrl}}/api/campaigns/nonexistent
Content-Type: application/json

{
  "name": "Ghost Campaign",
  "objective": "awareness"
}

### Delete campaign  [protected]
DELETE {{baseUrl}}/api/campaigns/{{campaignId}}

### Delete campaign — non-existent ID (expects 404)  [protected]
DELETE {{baseUrl}}/api/campaigns/nonexistent

### Generate draft posts for campaign  [protected]
# Requires ANTHROPIC_API_KEY to be set in the server environment.
# Returns 503 when the feature is disabled (no API key).
# Response is a Server-Sent Events stream.
# Events: "step" (progress), "complete" (ContentPlanResponse), "error" (code + message).
POST {{baseUrl}}/api/campaigns/{{campaignId}}/generate-draft
Accept: text/event-stream
