@baseUrl = http://localhost:9001

# All secrets endpoints require authentication.
# Run "Login" from sessions/sessions.http first.
#
# Allowlisted names (rejected with 400 otherwise):
#   - anthropic_api_key
#   - zernio_api_key
#
# The plaintext is never returned by any endpoint — responses carry
# metadata only (name, created_at, updated_at, kek_version, algorithm,
# decryptable). Validation errors never echo the submitted value.

### List configured secrets (metadata only)  [protected]
GET {{baseUrl}}/api/secrets
Accept: application/json

### Get secret metadata by name  [protected]
GET {{baseUrl}}/api/secrets/anthropic_api_key
Accept: application/json

### Create or replace anthropic_api_key  [protected]
PUT {{baseUrl}}/api/secrets/anthropic_api_key
Content-Type: application/json

{
  "value": "sk-ant-api03-REPLACE-ME"
}

### Create or replace zernio_api_key  [protected]
PUT {{baseUrl}}/api/secrets/zernio_api_key
Content-Type: application/json

{
  "value": "zernio-REPLACE-ME"
}

### Upsert — unknown name (expects 400)  [protected]
PUT {{baseUrl}}/api/secrets/openai_api_key
Content-Type: application/json

{
  "value": "sk-openai-irrelevant"
}

### Upsert — empty value (expects 400)  [protected]
PUT {{baseUrl}}/api/secrets/anthropic_api_key
Content-Type: application/json

{
  "value": ""
}

### Upsert — value with control character (expects 400)  [protected]
PUT {{baseUrl}}/api/secrets/anthropic_api_key
Content-Type: application/json

{
  "value": "sk-ant-api03-with-newline\n"
}

### Delete anthropic_api_key  [protected]
DELETE {{baseUrl}}/api/secrets/anthropic_api_key

### Delete zernio_api_key  [protected]
DELETE {{baseUrl}}/api/secrets/zernio_api_key

### Delete a non-existent secret (expects 404)  [protected]
DELETE {{baseUrl}}/api/secrets/anthropic_api_key

### Health — also reports per-secret presence and decryptability
GET {{baseUrl}}/api/health
Accept: application/json
