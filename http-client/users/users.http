@baseUrl = http://localhost:3000

### List all users
GET {{baseUrl}}/api/users
Accept: application/json

### Create user
# @name createUser
POST {{baseUrl}}/api/users
Content-Type: application/json

{
  "name": "Serhii Herasymov",
  "email": "serhii@daat.ua",
  "password": "s3cur3P@ssw0rd"
}

> {% client.global.set("userId", response.body.id) %}

### Create user — invalid email (expects 400)
POST {{baseUrl}}/api/users
Content-Type: application/json

{
  "name": "Serhii Herasymov",
  "email": "not-an-email",
  "password": "s3cur3P@ssw0rd"
}

### Create user — missing password (expects 400)
POST {{baseUrl}}/api/users
Content-Type: application/json

{
  "name": "Serhii Herasymov",
  "email": "serhii@daat.ua"
}

### Create user — password too short (expects 400)
POST {{baseUrl}}/api/users
Content-Type: application/json

{
  "name": "Serhii Herasymov",
  "email": "serhii@daat.ua",
  "password": "short"
}

### Get user by ID
GET {{baseUrl}}/api/users/{{userId}}
Accept: application/json

### Update user (name and email only)
PUT {{baseUrl}}/api/users/{{userId}}
Content-Type: application/json

{
  "name": "Bob Marley 2",
  "email": "bob@marley.com"
}

### Update user (with new password)
PUT {{baseUrl}}/api/users/{{userId}}
Content-Type: application/json

{
  "name": "Bob Marley 2",
  "email": "bob@marley.com",
  "password": "newP@ssw0rd"
}

### Update user — invalid email (expects 400)
PUT {{baseUrl}}/api/users/{{userId}}
Content-Type: application/json

{
  "name": "Bob Marley 2",
  "email": "not-an-email"
}

### Update user — password too short (expects 400)
PUT {{baseUrl}}/api/users/{{userId}}
Content-Type: application/json

{
  "name": "Bob Marley 2",
  "email": "bob@marley.com",
  "password": "short"
}

### Delete user
DELETE {{baseUrl}}/api/users/{{userId}}
