@baseUrl = http://localhost:9001

# CON-97: every endpoint here (create included) requires a valid session cookie
# and is scoped to the caller's tenant. List/Get only ever see users in your
# own tenant.
#
# The FIRST user is NOT created here — there is no public user-creation route
# anymore. Bootstrap a tenant + first user via "Signup" in tenants/tenants.http
# (or "Login" in sessions/sessions.http if the account already exists). Once
# authenticated, POST /api/users below adds MORE users to the same tenant; any
# tenant_id in the body is ignored.

### List all users (caller's tenant only)  [protected]
GET {{baseUrl}}/api/users
Accept: application/json

### Create user — joins the caller's tenant  [protected]
# @name createUser
# Use a different email than the signup user — email is globally unique, so a
# duplicate returns 409.
POST {{baseUrl}}/api/users
Content-Type: application/json

{
  "name": "Teammate Two",
  "email": "teammate@daat.ua",
  "password": "s3cur3P@ssw0rd"
}

> {% client.global.set("userId", response.body.id) %}

### Create user — invalid email (expects 400)
POST {{baseUrl}}/api/users
Content-Type: application/json

{
  "name": "Serhii Herasymov",
  "email": "not-an-email",
  "password": "s3cur3P@ssw0rd"
}

### Create user — missing password (expects 400)
POST {{baseUrl}}/api/users
Content-Type: application/json

{
  "name": "Serhii Herasymov",
  "email": "serhii@daat.ua"
}

### Create user — password too short (expects 400)
POST {{baseUrl}}/api/users
Content-Type: application/json

{
  "name": "Serhii Herasymov",
  "email": "serhii@daat.ua",
  "password": "short"
}

### Get user by ID  [protected]
GET {{baseUrl}}/api/users/{{userId}}
Accept: application/json

### Update user (name and email only)  [protected]
PUT {{baseUrl}}/api/users/{{userId}}
Content-Type: application/json

{
  "name": "Bob Marley 2",
  "email": "bob@marley.com"
}

### Update user (with new password)  [protected]
PUT {{baseUrl}}/api/users/{{userId}}
Content-Type: application/json

{
  "name": "Bob Marley 2",
  "email": "bob@marley.com",
  "password": "newP@ssw0rd"
}

### Update user — invalid email (expects 400)  [protected]
PUT {{baseUrl}}/api/users/{{userId}}
Content-Type: application/json

{
  "name": "Bob Marley 2",
  "email": "not-an-email"
}

### Update user — password too short (expects 400)  [protected]
PUT {{baseUrl}}/api/users/{{userId}}
Content-Type: application/json

{
  "name": "Bob Marley 2",
  "email": "bob@marley.com",
  "password": "short"
}

### Delete user  [protected]
DELETE {{baseUrl}}/api/users/{{userId}}
