# ─────────────────────────────────────────────────────────────────────
# story (Facebook / Instagram) — exactly 1 image or video
# ─────────────────────────────────────────────────────────────────────

### story — no attachments (expects 422 with rule=min_attachments)  [protected]
PUT {{baseUrl}}/api/posts/{{postId}}
Content-Type: application/json

{
  "campaign_id": "{{campaignId}}",
  "platform_id": "{{facebookId}}",
  "platform_post_type": "story",
  "status": "ready_for_publish"
}

# ─────────────────────────────────────────────────────────────────────
# Create — the gate applies symmetrically when creating a post directly
# in a non-draft state (no need to go through draft first).
# ─────────────────────────────────────────────────────────────────────

### Create directly in ready_for_publish — image-post w/o attachments (expects 422)  [protected]
POST {{baseUrl}}/api/posts
Content-Type: application/json

{
  "campaign_id": "{{campaignId}}",
  "platform_id": "{{linkedInId}}",
  "platform_post_type": "image-post",
  "title": "Premature image post",
  "status": "ready_for_publish"
}

### Create directly in ready_for_publish — text-post (expects 201)  [protected]
POST {{baseUrl}}/api/posts
Content-Type: application/json

{
  "campaign_id": "{{campaignId}}",
  "platform_id": "{{linkedInId}}",
  "platform_post_type": "text-post",
  "title": "Text in ready",
  "status": "ready_for_publish"
}

# ─────────────────────────────────────────────────────────────────────
# Drafts stay unconstrained — even with an unknown post type the gate
# is skipped because status=draft.
# ─────────────────────────────────────────────────────────────────────

### Draft save with unknown post type (expects 200)  [protected]
PUT {{baseUrl}}/api/posts/{{postId}}
Content-Type: application/json

{
  "campaign_id": "{{campaignId}}",
  "platform_id": "{{linkedInId}}",
  "platform_post_type": "make-believe-type",
  "status": "draft"
}
