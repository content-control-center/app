@baseUrl = http://localhost:9001

# All platform endpoints require authentication.
# Run "Login" from sessions/sessions.http first — the HTTP client stores and
# sends the cookie automatically on subsequent requests to the same host.
#
# Each platform in the response carries a `publishers` array describing
# which publishing backends (e.g. Zernio) support it, the post types
# each publisher can post in, and any social accounts the user has
# connected. Empty `publishers: []` means no integration is configured
# or none of them support that platform.
#
# `constraints` is opaque prose fed to the model. The machine-readable
# rules are the structured sibling objects: `image_constraints`,
# `pdf_constraints`, `video_constraints`, and `text_constraints` (CON-91,
# character limits). A zero/empty object means "no rules of that kind".
# text_constraints.max_content_chars is the default body ceiling;
# per_post_type overrides it per slug (e.g. LinkedIn articles); the
# per-slug value is also projected into the post-type-rules response
# (see post-type-validation/char-limits.http). Example shape:
#
#   {
#     "id": "linkedin",
#     "name": "LinkedIn",
#     "post_types": { "text-post": "...", ... },
#     "cadence": "...",
#     "constraints": "...",
#     "image_constraints": { "max_file_size_bytes": 10485760, "allowed_formats": ["jpeg","png","gif"], "animated_gif_supported": false, "max_attachments_per_post": 9 },
#     "pdf_constraints":   { "max_file_size_bytes": 104857600, "allowed_formats": ["pdf"], "max_pages": 300, "max_attachments_per_post": 1 },
#     "video_constraints": { "max_file_size_bytes": 5368709120, "allowed_formats": ["mp4"], ... },
#     "text_constraints":  { "max_content_chars": 3000, "max_title_chars": 0, "per_post_type": { "article": 100000 } },
#     "publishers": [
#       {
#         "id": "zernio",
#         "name": "Zernio",
#         "state": "ok",
#         "connected": true,
#         "supported_post_types": ["text-post", "image-post", "carousel", "video"],
#         "accounts": [
#           { "id": "acc_abc", "username": "ogen-team",
#             "display_name": "Ogen", "is_active": true,
#             "connected_at": "..." }
#         ]
#       }
#     ]
#   }

### List all platforms (with publishers)  [protected]
GET {{baseUrl}}/api/platforms
Accept: application/json

### Get seeded platform — LinkedIn  [protected]
GET {{baseUrl}}/api/platforms/AXqWG7U2qnpt
Accept: application/json

### Get seeded platform — YouTube  [protected]
GET {{baseUrl}}/api/platforms/8S8bWQTG6qD
Accept: application/json

### Get seeded platform — Facebook  [protected]
GET {{baseUrl}}/api/platforms/zBU1zqVICGfk
Accept: application/json

### Get seeded platform — X (Twitter)  [protected]
GET {{baseUrl}}/api/platforms/81mUCmc2xsKd
Accept: application/json

### Get seeded platform — Threads  [protected]
GET {{baseUrl}}/api/platforms/pQ4yxT3SuE57
Accept: application/json

### Get seeded platform — Instagram  [protected]
GET {{baseUrl}}/api/platforms/rzgpTkARLH0L
Accept: application/json

### Create platform  [protected]
# @name createPlatform
POST {{baseUrl}}/api/platforms
Content-Type: application/json

{
  "name": "TikTok",
  "post_types": {
    "video": "Video",
    "live": "Live stream",
    "story": "Story (24h ephemeral)",
    "duet": "Duet"
  },
  "cadence": "1–3 videos per day",
  "constraints": "videos up to 10 min; captions up to 2200 chars; trending audio recommended"
}

> {% client.global.set("platformId", response.body.id) %}

### Create platform — no post_types  [protected]
POST {{baseUrl}}/api/platforms
Content-Type: application/json

{
  "name": "Pinterest"
}

### Create platform — missing name (expects 400)  [protected]
POST {{baseUrl}}/api/platforms
Content-Type: application/json

{
  "post_types": {
    "pin": "Pin"
  }
}

### Get platform by ID  [protected]
GET {{baseUrl}}/api/platforms/{{platformId}}
Accept: application/json

### Get platform — non-existent ID (expects 404)  [protected]
GET {{baseUrl}}/api/platforms/nonexistent
Accept: application/json

### Update platform  [protected]
PUT {{baseUrl}}/api/platforms/{{platformId}}
Content-Type: application/json

{
  "name": "TikTok",
  "post_types": {
    "video": "Video",
    "live": "Live stream",
    "story": "Story (24h ephemeral)",
    "duet": "Duet",
    "series": "Series"
  },
  "cadence": "1–3 videos per day",
  "constraints": "videos up to 10 min; captions up to 2200 chars; trending audio recommended"
}

### Update platform — missing name (expects 400)  [protected]
PUT {{baseUrl}}/api/platforms/{{platformId}}
Content-Type: application/json

{
  "post_types": {}
}

### Update platform — non-existent ID (expects 404)  [protected]
PUT {{baseUrl}}/api/platforms/nonexistent
Content-Type: application/json

{
  "name": "Ghost Platform"
}

### Delete platform  [protected]
DELETE {{baseUrl}}/api/platforms/{{platformId}}

### Delete platform — non-existent ID (expects 404)  [protected]
DELETE {{baseUrl}}/api/platforms/nonexistent
