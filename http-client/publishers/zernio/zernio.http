@baseUrl = http://localhost:9001

# Most Zernio endpoints require authentication.
# Run "Signup" (tenants/tenants.http) or "Login" (sessions/sessions.http) first
# — the HTTP client stores and sends the session cookie automatically, and the
# cookie's tenant scopes every call below.
#
# CON-100 — per-tenant profiles under ONE shared Zernio account:
#   - ZERNIO_API_KEY is a single INSTANCE-WIDE secret (all tenants authenticate
#     Ogen to the same Zernio account); it is not per-tenant.
#   - Each tenant gets its OWN Zernio profile, "Ogen integration <tenant_id>",
#     created lazily on that tenant's FIRST connect-link (or profile/repair).
#   - connect-links / accounts / sync / profile-repair below all act on the
#     CALLER'S tenant profile only, resolved from the session cookie.
#
# /health is intentionally unauthenticated, matching /api/health.
#
# Useful env knobs when running the server:
#   ZERNIO_API_KEY=<key>            # required to enable the integration
#   ZERNIO_BASE_URL=<url>           # defaults to https://zernio.com/api/v1
#   ZERNIO_HTTP_TIMEOUT=15s
#   ZERNIO_SYNC_INTERVAL=30s
#   ZERNIO_SYNC_INTERVAL_FAST=5s
#   ZERNIO_REDIRECT_URL=<url>       # optional; landing page after OAuth.
#                                   # Zernio appends ?connected=<platform>
#                                   # &profileId=<id>&accountId=<id>&username=<name>

### Health — instance-wide enabled/state  [public]
# Unauthenticated, so it carries no tenant. `enabled` and `state` are
# instance-wide. The remaining fields (profileId / accountCount / lastSync*)
# are per-tenant and read tenant-scoped settings — heads-up: with no tenant in
# context that read fails closed under CON-100 (see the note handed back with
# this change). Treat enabled/state as the reliable monitoring signal.
GET {{baseUrl}}/api/integrations/zernio/health
Accept: application/json

### List Phase 1 platform allowlist with supportedPostTypes  [protected, deprecated]
# DEPRECATED: prefer GET /api/platforms (CON-63), which surfaces the
# same publisher information inline per platform plus connection
# state. Kept for clients that haven't migrated yet.
GET {{baseUrl}}/api/integrations/zernio/platforms
Accept: application/json

### Create connect link — LinkedIn  [protected]
# @name connectLinkLinkedIn
# First connect for a tenant lazily bootstraps that tenant's Zernio profile,
# then issues the link (and can self-heal a degraded integration).
POST {{baseUrl}}/api/integrations/zernio/connect-links
Content-Type: application/json

{
  "platform": "linkedin"
}

> {% client.global.set("zernioConnectURL", response.body.connectUrl) %}

### Create connect link — LinkedIn (SECOND same-platform account) — CON-150  [protected]
# Connecting the same platform again adds ANOTHER account to the profile
# (Zernio's agency model — multiple accounts per platform). After authorizing a
# different LinkedIn login, the tenant has two LinkedIn accounts; "List accounts"
# below returns both, and posts must then choose between them via
# social_account_id (see posts/posts.http and posts/schedule.http).
POST {{baseUrl}}/api/integrations/zernio/connect-links
Content-Type: application/json

{
  "platform": "linkedin"
}

### Create connect link — Twitter (Zernio uses "twitter", not "x-twitter")  [protected]
POST {{baseUrl}}/api/integrations/zernio/connect-links
Content-Type: application/json

{
  "platform": "twitter"
}

