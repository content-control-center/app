}

# Rate-limit smoke test: the bucket is 30/min per Ogen instance, SHARED across
# all tenants (the limiter is instance-wide, not per-tenant). Run this block 31
# times in quick succession to see the 31st return 429 with a Retry-After header.
### Rate-limit probe (run 31x; the 31st expects 429 rate_limited)  [protected]
POST {{baseUrl}}/api/integrations/zernio/connect-links
Content-Type: application/json

{
  "platform": "linkedin"
}

### List local social-account mirror + last sync metadata (caller's tenant)  [protected]
# @name listZernioAccounts
# CON-150: multiple accounts on the SAME platform now appear here (e.g. two
# LinkedIn rows). Captures the first two LinkedIn account ids into
# {{linkedinAccountId}} / {{linkedinAccountId2}} so posts.http / schedule.http
# can target a specific account via social_account_id.
GET {{baseUrl}}/api/integrations/zernio/accounts
Accept: application/json

> {%
    const accounts = (response.body && response.body.accounts) || [];
    const linkedin = accounts.filter(a => a.platform === "linkedin");
    if (linkedin[0]) client.global.set("linkedinAccountId", linkedin[0].id);
    if (linkedin[1]) client.global.set("linkedinAccountId2", linkedin[1].id);
%}

### Trigger an immediate sync tick  [protected]
# Nudges the background worker, which sweeps every tenant that has a profile;
# results land per tenant.
POST {{baseUrl}}/api/integrations/zernio/sync
Accept: application/json

### Repair profile — re-bootstraps the CALLER'S tenant profile (idempotent)  [protected]
POST {{baseUrl}}/api/integrations/zernio/profile/repair
Accept: application/json
