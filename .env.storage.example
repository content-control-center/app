# Cloudflare R2 (S3-compatible) object storage for image/PDF uploads.
#
# Copy this file and fill in real values (the copy is gitignored):
#   cp .env.storage.example .env.storage
#
# Loaded into the `api` container via docker-compose.yml (env_file).
# Leave STORAGE_ENDPOINT empty to disable image uploads entirely.
STORAGE_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
STORAGE_REGION=auto
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=
STORAGE_PUBLIC_URL=https://pub-<hash>.r2.dev
